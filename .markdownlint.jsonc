{
    // https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md

    "MD001": true,                                // Keep heading levels hierarchical.
    "MD003": { "style": "atx" },                  // Use hash-prefixed headings.
    "MD004": { "style": "dash" },                 // Use dashes for unordered lists.
    "MD007": { "indent": 4 },                     // Indent nested list items with four spaces.
    "MD009": { "br_spaces": 0, "strict": true }, // Remove trailing spaces.
    "MD012": true,                                // Avoid multiple consecutive blank lines.
    "MD013": false,                               // Allow lines of any length.
    "MD022": true,                                // Surround headings with blank lines.
    "MD024": { "siblings_only": true },           // Allow repeated headings only in separate sections.
    "MD025": true,                                // Treat a front matter title as the page's only H1.
    "MD026": { "punctuation": ".,;:" },           // Allow only the project-approved trailing heading punctuation.
    "MD029": { "style": "ordered" },              // Number ordered-list items sequentially.
    "MD031": true,                                // Surround fenced code blocks with blank lines.
    "MD032": true,                                // Surround lists with blank lines.
    "MD033": false,                               // Allow inline HTML for images and generated content.
    "MD034": true,                                // Require explicit Markdown links or angle-bracket autolinks.
    "MD036": { "punctuation": ".,;:!。" },        // Do not use emphasis in place of headings.
    "MD040": true,                                // Add a language identifier to fenced code blocks.
    "MD041": false,                               // Do not require generated pages to start with a Markdown H1.
    "MD045": false,                               // Allow HTML images whose context supplies accessibility information.
    "MD046": false,                               // Allow indented MkDocs admonition bodies alongside fenced code.
    "MD048": { "style": "backtick" },             // Fence code blocks with backticks.
    "MD049": { "style": "underscore" },           // Use underscores for emphasis.
    "MD050": { "style": "asterisk" },             // Use asterisks for strong emphasis.
    "MD055": { "style": "leading_and_trailing" }, // Include leading and trailing table pipes.
    "MD056": true,                                // Keep the same number of cells in every table row.
    "MD060": { "style": "compact" },              // Use compact spacing around table delimiters.
    "MAS-LINT-009": true,                         // Prohibit horizontal rules outside YAML front matter.
    "MAS-LINT-010": true,                         // Require HTML images with src as the first attribute.
    "MAS-LINT-011": true,                         // Enforce project identifier syntax by Markdown context.
    "MAS-LINT-012": true,                         // Format chapter references so URLs print in generated PDFs.
    "MAS-LINT-013": true,                         // Omit dollar-sign prompts from every shell command block.
    "search-replace": {                          // Apply deterministic text substitutions defined below.
      "rules": [
        {
          "name": "curly-double-quotes", // Replace curly double quotes with portable straight quotes.
          "message": "MAS-LINT-001/Do not use curly double quotes.",
          "searchPattern": "/“|”/g",
          "replace": "\"",
          "searchScope": "text"
        },
        {
          "name": "nbsp", // Replace invisible no-break spaces with normal spaces.
          "message": "MAS-LINT-002/Don't use no-break spaces",
          "searchPattern": "/ /g",
          "replace": " ",
          "searchScope": "all"
        },
        {
          "name": "curly-single-quotes", // Replace curly apostrophes and single quotes with straight ones.
          "message": "MAS-LINT-003/Don't use curly single quotes",
          "searchPattern": "/‘|’/g",
          "replace": "'",
          "searchScope": "text"
        },
        {
          "name": "gender-neutrality", // Detect gendered pronouns that require neutral wording.
          "message": "MAS-LINT-004/Ensure gender-neutral language is used.",
          "searchPattern": "/\\bhe\\b|\\bshe\\b|\\bhis\\b|\\bhimself\\b|\\bherself\\b|\\bher\\b|\\bhim\\b|\\bhers\\b/g",
          "replace": ""
        },
        {
          "name": "double-spaces", // Collapse accidental double spaces in prose.
          "message": "MAS-LINT-006/Avoid double spaces",
          "searchPattern": "/([^\\s>])  ([^\\s|])/g",
          "replace": "$1 $2",
          "searchScope": "text"
        },
        {
          "name": "project-terminology", // Normalize deterministic MASTG terminology without changing code or quotations.
          "message": "MAS-LINT-007/Use the preferred project terminology.",
          "searchPattern": [
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b(?:MacOS|Mac OS|macos)\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b(?:AppStore|Appstore|appstore)\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Bb])ack(?:End|[ -]end)\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b(?:base64|BASE64)\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Bb])lack[Bb]ox\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b(?:BundleID|bundleID|[Bb]undle id)\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Bb])yte(?:Code|[ -]code)\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Cc])ode(?:Base|[ -]base)\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Cc])ode[Ss]igning\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Cc])ommand[Ll]ine\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Ff])ile(?:Name|name)\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Ff])ile-name\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b(?:OSX|osx)\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Pp])en[ -]test\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b(?:Phonegap|phonegap)\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<!`)(?<![\\x2F:_.?&=#(-])\\b(?:python|PYTHON)\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Rr])e-package\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Rr])un[ -]time\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Ss])napshot[Ll]ength\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Uu])se[Cc]ase\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b(?:WiFi|wifi|WIFI)\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Ww])hite[Bb]ox\\b/gm"
          ],
          "replace": [
            "macOS",
            "App Store",
            "$1ackend",
            "Base64",
            "$1lack box",
            "Bundle ID",
            "$1ytecode",
            "$1odebase",
            "$1ode signing",
            "$1ommand line",
            "$1ile name",
            "$1ile name",
            "OS X",
            "$1entest",
            "PhoneGap",
            "Python",
            "$1epackage",
            "$1untime",
            "$1napshot length",
            "$1se case",
            "Wi-Fi",
            "$1hite box"
          ],
          "searchScope": "text"
        },
        {
          "name": "contractions", // Require only unambiguous contractions without changing code or quotations.
          "message": "MAS-LINT-008/Use the preferred contraction.",
          "searchPattern": [
            "/(?<!^\\s{0,3}>.*)\\b([Aa])re not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Cc])annot\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Cc])ould not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Dd])id not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Dd])o not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Dd])oes not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Hh])as not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Hh])ad not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Hh])ave not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Ii])s not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Ww])as not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Ww])ere not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Ww])ill not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Ww])ould not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Yy])ou are\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Yy])ou will\\b/gm"
          ],
          "replace": [
            "$1ren't",
            "$1an't",
            "$1ouldn't",
            "$1idn't",
            "$1on't",
            "$1oesn't",
            "$1asn't",
            "$1adn't",
            "$1aven't",
            "$1sn't",
            "$1asn't",
            "$1eren't",
            "$1on't",
            "$1ouldn't",
            "$1ou're",
            "$1ou'll"
          ],
          "searchScope": "text"
        },
      ]
    }
  }
