{
    // https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md

    "MD004": {"style": "dash"},                   // ul-style
    "MD007": { "indent": 4 },                     // ul-indent
    "MD013": false,                               // line-length
    "MD014": false,                               // commands-show-output
    "MD024": {"siblings_only": true},             // no-duplicate-header
    "MD026": {"punctuation": ".,;:"},             // no-trailing-punctuation (allows !?)
    "MD033": false,                               // no-inline-html
    "MD035": {"style": "---"},                    // hr-style
    "MD036": {"punctuation": ".,;:!。"},          // no-emphasis-as-header
    "MD041": false,                               // first-line-h1
    "MD045": false,                               // no-alt-text
    "MD046": false,                               // code-block-style (unsupported admonitions)
    "MD049": {"style": "underscore"},             // emphasis-style
    "MD050": {"style": "asterisk"},               // strong-style
    "MD055": {"style": "leading_and_trailing"},   // table-pipe-style
    "MD060": {"style": "compact"},
    "search-replace": {
      "rules": [
        {
          "name": "curly-double-quotes",
          "message": "MAS-LINT-001/Do not use curly double quotes.",
          "searchPattern": "/“|”/g",
          "replace": "\"",
          "searchScope": "text"
        },
        {
          "name": "nbsp",
          "message": "MAS-LINT-002/Don't use no-break spaces",
          "searchPattern": "/ /g",
          "replace": " ",
          "searchScope": "all"
        },
        {
          "name": "curly-single-quotes",
          "message": "MAS-LINT-003/Don't use curly single quotes",
          "searchPattern": "/‘|’/g",
          "replace": "'",
          "searchScope": "text"
        },
        {
          "name": "gender-neutrality",
          "message": "MAS-LINT-004/Ensure gender-neutral language is used.",
          "searchPattern": "/\\bhe\\b|\\bshe\\b|\\bhis\\b|\\bhimself\\b|\\bherself\\b|\\bher\\b|\\bhim\\b|\\bhers\\b/g",
          "replace": ""
        },
        {
          "name": "trailing-spaces",
          "message": "MAS-LINT-005/Avoid trailing spaces",
          "searchPattern": "/  +$/gm",
          "replace": "",
          "searchScope": "all"
        },
        {
          "name": "double-spaces",
          "message": "MAS-LINT-006/Avoid double spaces",
          "searchPattern": "/([^\\s>])  ([^\\s|])/g",
          "replace": "$1 $2",
          "searchScope": "text"
        },
        {
          "name": "project-terminology",
          "message": "MAS-LINT-007/Use the preferred project terminology.",
          "searchPattern": [
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b(?:MacOS|Mac OS|macos)\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b(?:AppStore|Appstore|appstore)\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Bb])ack(?:End|[ -]end)\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b(?:base64|BASE64)\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Bb])lack[Bb]ox\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b(?:BundleID|bundleID|[Bb]undle id)\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Bb])yte(?:Code|[ -]code)\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Cc])ode(?:Base|[ -]base)\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Cc])ode[Ss]igning\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Cc])ommand[Ll]ine\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Ff])ile(?:Name|name)\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Ff])ile-name\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b(?:OSX|osx)\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Pp])en[ -]test\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b(?:Phonegap|phonegap)\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<!`)(?<![\\x2F:_.?&=#(-])\\b(?:python|PYTHON)\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Rr])e-package\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Rr])un[ -]time\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Ss])napshot[Ll]ength\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Uu])se[Cc]ase\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b(?:WiFi|wifi|WIFI)\\b/gm",
            "/(?<!^\\s{0,3}>.*)(?<![\\x2F:_.?&=#(-])\\b([Ww])hite[Bb]ox\\b/gm"
          ],
          "replace": [
            "macOS",
            "App Store",
            "$1ackend",
            "Base64",
            "$1lack box",
            "Bundle ID",
            "$1ytecode",
            "$1odebase",
            "$1ode signing",
            "$1ommand line",
            "$1ile name",
            "$1ile name",
            "OS X",
            "$1entest",
            "PhoneGap",
            "Python",
            "$1epackage",
            "$1untime",
            "$1napshot length",
            "$1se case",
            "Wi-Fi",
            "$1hite box"
          ],
          "searchScope": "text"
        },
        {
          "name": "contractions",
          "message": "MAS-LINT-008/Use the preferred contraction.",
          "searchPattern": [
            "/(?<!^\\s{0,3}>.*)\\b([Aa])re not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Cc])annot\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Cc])ould not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Dd])id not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Dd])o not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Dd])oes not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Hh])as not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Hh])ad not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Hh])ave not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Ii])s not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Ww])as not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Ww])ere not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Ww])ill not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Ww])ould not\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Yy])ou are\\b/gm",
            "/(?<!^\\s{0,3}>.*)\\b([Yy])ou will\\b/gm"
          ],
          "replace": [
            "$1ren't",
            "$1an't",
            "$1ouldn't",
            "$1idn't",
            "$1on't",
            "$1oesn't",
            "$1asn't",
            "$1adn't",
            "$1aven't",
            "$1sn't",
            "$1asn't",
            "$1eren't",
            "$1on't",
            "$1ouldn't",
            "$1ou're",
            "$1ou'll"
          ],
          "searchScope": "text"
        },
      ]
    }
  }
