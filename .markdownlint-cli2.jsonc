{
  "config": {
    "extends": "./.markdownlint.jsonc"
  },
  "globs": [
    "**/*.md"
  ],
  "customRules": [
    "markdownlint-rule-search-replace", // Enforce deterministic wording and character substitutions.
    ".github/markdownlint-rules/mas-markdown.js" // Enforce MASTG-specific Markdown structure.
  ],
  "ignores": ["node_modules", ".git", "License.md", ".github/workflows", ".github/scripts", ".github/ISSUE_TEMPLATE", "src", "Crackmes", "Samples", "venv"],
  "gitignore": true
}